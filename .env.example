NODE_ENV=production

APP_URL=https://almacenlasbalinerasexcel.netlify.app
API_URL=https://excelseguro.duckdns.org/api
FRONTEND_ORIGIN=https://almacenlasbalinerasexcel.netlify.app
# Optional: comma-separated extra frontend origins, useful for a custom Netlify domain or preview URL.
FRONTEND_ORIGINS=

HOST=127.0.0.1
PORT=3000
TRUST_PROXY=true

DATABASE_URL=postgres://secure_spreadsheet:CHANGE_ME@127.0.0.1:5432/secure_spreadsheet
REDIS_URL=redis://127.0.0.1:6379

SESSION_SECRET_FILE=/opt/secure-spreadsheet/secrets/session.key
MASTER_ENCRYPTION_KEY_FILE=/opt/secure-spreadsheet/secrets/master.key
AUDIT_HMAC_KEY_FILE=/opt/secure-spreadsheet/secrets/audit-hmac.key

DEVICE_CA_KEY_FILE=/opt/secure-spreadsheet/secrets/device-ca.key
DEVICE_CA_CERT_FILE=/opt/secure-spreadsheet/secrets/device-ca.crt

DEVICE_SECURITY_MODE=mtls

STORAGE_DIR=/opt/secure-spreadsheet/storage
TMP_DIR=/opt/secure-spreadsheet/tmp

MAX_UPLOAD_MB=50
MAX_ROWS_PER_REQUEST=100

SESSION_IDLE_TIMEOUT_MINUTES=15
SINGLE_SESSION_PER_USER=true
SESSION_COOKIE_SAME_SITE=none

TOTP_ISSUER=Secure Spreadsheet Workspace

AUDIT_INCLUDE_CELL_VALUES=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
ENROLLMENT_TOKEN_TTL_MINUTES=15
