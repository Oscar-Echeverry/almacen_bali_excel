[Unit]
Description=Secure Spreadsheet Workspace backup

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/secure-spreadsheet/production.env
ExecStart=/opt/secure-spreadsheet/scripts/backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/secure-spreadsheet/backups
